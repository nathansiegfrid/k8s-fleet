{
  "uid": "cluster-health",
  "title": "Cluster Health",
  "tags": [
    "homelab",
    "kube-state-metrics",
    "prometheus"
  ],
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 5,
      "type": "stat",
      "title": "Alerts firing",
      "description": "Alerts firing now, one per row of the Alerts timeline. A TargetDown is left out while its node isn't Ready, as Alertmanager inhibits it, and for 2 minutes either side.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(max by (alertname, subject, mountpoint) (label_replace(label_join(label_replace(label_replace(label_replace(label_join(label_replace((ALERTS{alertstate=\"firing\"} unless on (alertname, node) label_replace(max_over_time(ALERTS{alertname=\"NodeNotReady\", alertstate=\"firing\"}[4m] offset -2m), \"alertname\", \"TargetDown\", \"\", \"\")), \"subject\", \"$1\", \"instance\", \"(.+)\"), \"nspod\", \"/\", \"namespace\", \"pod\"), \"subject\", \"$1\", \"node\", \"(.+)\"), \"subject\", \"$1\", \"nspod\", \"(.+/.+)\"), \"subject\", \"$1\", \"rule_group\", \"(.+)\"), \"target\", \";\", \"alertname\", \"subject\", \"job\"), \"subject\", \"$1 $2\", \"target\", \"TargetDown;(.+);(.+)\")))) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Alerts resolved",
      "description": "Alerts that fired during the time range and aren't firing now, one per row of the Alerts timeline. An alert that resolved and fired again counts as firing. A TargetDown is left out while its node isn't Ready, as Alertmanager inhibits it, and for 2 minutes either side.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(max_over_time((max by (alertname, subject, mountpoint) (label_replace(label_join(label_replace(label_replace(label_replace(label_join(label_replace((ALERTS{alertstate=\"firing\"} unless on (alertname, node) label_replace(max_over_time(ALERTS{alertname=\"NodeNotReady\", alertstate=\"firing\"}[4m] offset -2m), \"alertname\", \"TargetDown\", \"\", \"\")), \"subject\", \"$1\", \"instance\", \"(.+)\"), \"nspod\", \"/\", \"namespace\", \"pod\"), \"subject\", \"$1\", \"node\", \"(.+)\"), \"subject\", \"$1\", \"nspod\", \"(.+/.+)\"), \"subject\", \"$1\", \"rule_group\", \"(.+)\"), \"target\", \";\", \"alertname\", \"subject\", \"job\"), \"subject\", \"$1 $2\", \"target\", \"TargetDown;(.+);(.+)\")))[$__range:]) unless max by (alertname, subject, mountpoint) (label_replace(label_join(label_replace(label_replace(label_replace(label_join(label_replace((ALERTS{alertstate=\"firing\"} unless on (alertname, node) label_replace(max_over_time(ALERTS{alertname=\"NodeNotReady\", alertstate=\"firing\"}[4m] offset -2m), \"alertname\", \"TargetDown\", \"\", \"\")), \"subject\", \"$1\", \"instance\", \"(.+)\"), \"nspod\", \"/\", \"namespace\", \"pod\"), \"subject\", \"$1\", \"node\", \"(.+)\"), \"subject\", \"$1\", \"nspod\", \"(.+/.+)\"), \"subject\", \"$1\", \"rule_group\", \"(.+)\"), \"target\", \";\", \"alertname\", \"subject\", \"job\"), \"subject\", \"$1 $2\", \"target\", \"TargetDown;(.+);(.+)\")))) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Targets down",
      "description": "Scrape targets Prometheus can't reach now.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(up == 0)) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes not Ready",
      "description": "Nodes whose Ready condition isn't true.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(label_replace(kube_node_status_condition{condition=\"Ready\", status=\"true\"} == 0, \"condition\", \"NotReady\", \"\", \"\"))) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods with problems",
      "description": "Pods pending, failed, unknown, terminating, running but not Ready, or with a container waiting, such as in CrashLoopBackOff or ImagePullBackOff. Each pod and reason counts once.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(max by (namespace, pod, reason) (label_replace(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1, \"reason\", \"$1\", \"phase\", \"(.+)\") or kube_pod_container_status_waiting_reason == 1 or label_replace(kube_pod_deletion_timestamp > 0, \"reason\", \"Terminating\", \"\", \"\") or label_replace((kube_pod_status_ready{condition=\"false\"} == 1) and on (namespace, pod) (kube_pod_status_phase{phase=\"Running\"} == 1) unless on (namespace, pod) (kube_pod_container_status_waiting_reason == 1) unless on (namespace, pod) kube_pod_deletion_timestamp, \"reason\", \"NotReady\", \"\", \"\")))) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pod restarts",
      "description": "Container restarts over the time range.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[$__range])))) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Alerts",
      "description": "When each alert fired over the time range. A TargetDown is left out while its node isn't Ready, as Alertmanager inhibits it, and for 2 minutes either side.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "firing"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (alertname, subject, mountpoint) (label_replace(label_join(label_replace(label_replace(label_replace(label_join(label_replace((ALERTS{alertstate=\"firing\"} unless on (alertname, node) label_replace(max_over_time(ALERTS{alertname=\"NodeNotReady\", alertstate=\"firing\"}[4m] offset -2m), \"alertname\", \"TargetDown\", \"\", \"\")), \"subject\", \"$1\", \"instance\", \"(.+)\"), \"nspod\", \"/\", \"namespace\", \"pod\"), \"subject\", \"$1\", \"node\", \"(.+)\"), \"subject\", \"$1\", \"nspod\", \"(.+/.+)\"), \"subject\", \"$1\", \"rule_group\", \"(.+)\"), \"target\", \";\", \"alertname\", \"subject\", \"job\"), \"subject\", \"$1 $2\", \"target\", \"TargetDown;(.+);(.+)\"))",
          "legendFormat": "{{alertname}} {{subject}} {{mountpoint}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Pods with problems",
      "description": "Pods pending, failed, unknown, terminating or running but not Ready, and pods with a container waiting, with the reason. A pod can have a row for each. A pod stuck terminating on a node that isn't Ready is gone once the node is back, or deleted with --force.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace, pod, reason) (label_replace(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"} == 1, \"reason\", \"$1\", \"phase\", \"(.+)\") or kube_pod_container_status_waiting_reason == 1 or label_replace(kube_pod_deletion_timestamp > 0, \"reason\", \"Terminating\", \"\", \"\") or label_replace((kube_pod_status_ready{condition=\"false\"} == 1) and on (namespace, pod) (kube_pod_status_phase{phase=\"Running\"} == 1) unless on (namespace, pod) (kube_pod_container_status_waiting_reason == 1) unless on (namespace, pod) kube_pod_deletion_timestamp, \"reason\", \"NotReady\", \"\", \"\")) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "node": "Node",
              "reason": "Reason"
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "node": 2,
              "reason": 3
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Namespace",
                "Pod",
                "Node",
                "Reason"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Most restarts",
      "description": "The ten pods whose containers restarted most over the time range. The pods of a workload, and why they stopped, are in Cluster Usage.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, round(sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[$__range]))) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "Value": "Restarts"
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value": 2
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Namespace",
                "Pod",
                "Restarts"
              ]
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Restarts",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Node problems",
      "description": "Nodes that aren't Ready, or report memory, disk or PID pressure, or no network.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
