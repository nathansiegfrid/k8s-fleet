{
  "uid": "node-pod-usage",
  "title": "Node Pod Usage",
  "tags": ["homelab", "cadvisor"],
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=\"node-exporter\"}, node)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"node-exporter\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "regex": "",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "$node",
      "collapsed": false,
      "repeat": "node",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU by pod",
      "description": "Each pod's CPU usage in cores, stacked, so the top of the stack is the node's total for its pods. From cAdvisor: the sum of the pod's containers, leaving out the pod-level cgroup, which would count them twice. The dotted line is the node's allocatable CPU, not stacked.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "axisLabel": "cores",
            "axisWidth": 30,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "allocatable" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none", "group": "A" } },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [0, 10] } },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"], "sortBy": "Last *", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{node=\"$node\", container!=\"\", container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}}/{{pod}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_node_status_allocatable{resource=\"cpu\", node=\"$node\"}",
          "legendFormat": "allocatable"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory by pod",
      "description": "Each pod's working set, stacked: the memory the kubelet counts for eviction and the kernel can't reclaim without pressure. From cAdvisor: the sum of the pod's containers, leaving out the pod-level cgroup, which would count them twice. The dotted line is the node's allocatable memory, not stacked.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "axisWidth": 70,
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "allocatable" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none", "group": "A" } },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [0, 10] } },
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"], "sortBy": "Last *", "sortDesc": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{node=\"$node\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_node_status_allocatable{resource=\"memory\", node=\"$node\"}",
          "legendFormat": "allocatable"
        }
      ]
    }
  ]
}
